          ],
          "path": []
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Welcome response is JSON', () => pm.response.to.be.json);"
            ]
          }
        }
